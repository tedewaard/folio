package templates

templ HomePage() {
	@Base("Home - Folio") {
		<div class="text-center py-16 px-4">
			<h1 class="text-5xl font-bold text-gray-900 mb-4">Welcome to Folio</h1>
			<p class="text-xl text-gray-600 mb-8">A modern portfolio website built with Go, Templ, and Datastar.</p>
			<div class="mt-8 flex bg-" >
				<a href="/blog" class="inline-block px-8 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-700 transition">View Blog</a>
			</div>
		</div>
	}
}
