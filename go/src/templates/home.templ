package templates

templ HomePage() {
	@Base("Home - Folio") {
		<div class="home-container">
			<h1>Welcome to Folio</h1>
			<p>A modern portfolio website built with Go, Templ, and Datastar.</p>
			<div class="home-links">
				<a href="/blog" class="btn-primary">View Blog</a>
			</div>
		</div>
	}
}
